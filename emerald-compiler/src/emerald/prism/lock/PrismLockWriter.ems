namespace emerald::prism::lock;

use emerald::prism::config::PrismAsset;
use emerald::prism::config::PrismDependency;
use emerald::prism::config::PrismProject;
use Std::Io::Files;

public class PrismLockWriter {
    public PrismLockWriter() {
    }

    public Void write(String path, PrismProject project) {
        String text = "";
        text = text + "# prism.lock\n";
        text = text + "# generated by Prism\n";
        text = text + "\n";
        text = text + "[package]\n";
        text = text + "name = \"" + project.name() + "\"\n";
        text = text + "version = \"" + project.version() + "\"\n";
        text = text + "\n";
        text = text + "[registry]\n";
        text = text + "default = \"" + project.registry() + "\"\n";
        text = text + "\n";
        text = text + "[dependencies]\n";

        Int dependencyIndex = 0;

        while (dependencyIndex < project.dependencies().length()) {
            PrismDependency dependency = project.dependencies().get(dependencyIndex);
            text = text + dependency.name() + " = \"" + dependency.version() + "\"\n";
            dependencyIndex = dependencyIndex + 1;
        }

        text = text + "\n";
        text = text + "[dependency.sources]\n";

        dependencyIndex = 0;

        while (dependencyIndex < project.dependencies().length()) {
            PrismDependency dependency = project.dependencies().get(dependencyIndex);
            text = text + dependency.name() + " = \"" + dependency.displaySource() + "\"\n";
            dependencyIndex = dependencyIndex + 1;
        }

        text = text + "\n";
        text = text + "[assets]\n";

        Int assetIndex = 0;

        while (assetIndex < project.assets().length()) {
            PrismAsset asset = project.assets().get(assetIndex);
            text = text + asset.name() + " = \"" + asset.version() + "\"\n";
            assetIndex = assetIndex + 1;
        }

        Files.writeText(path, text);
    }
}
