namespace emerald::compiler::backend;

use emerald::compiler::syntax::Expression;
use emerald::compiler::syntax::MethodDeclaration;
use emerald::compiler::syntax::SyntaxProgram;
use Std::Collections::ArrayList;
use Std::Llvm::LlvmNativeBackend;
use Std::Llvm::LlvmRuntimeFunction;
use Std::Llvm::LlvmType;
use Std::Llvm::LlvmValue;

public class NativeLlvmBridgeEmitter {
    private NativeEmitContext context;
    private NativeExpressionEmitter expressions;
    private NativeLookup lookup;

    public NativeLlvmBridgeEmitter(NativeEmitContext emitContext, NativeExpressionEmitter expressionEmitter) {
        this.context = emitContext;
        this.expressions = expressionEmitter;
        this.lookup = NativeLookup();
    }

    public Bool supports(String receiver, String method) {
        if (receiver != "LlvmNative") {
            return false;
        }

        return !this.nativeName(method).isEmpty();
    }

    public LlvmValue emit(Expression expression, SyntaxProgram program, LlvmNativeBackend backend, List<NativeLocal> locals) {
        MethodDeclaration method = this.lookup.findStaticMethod(program, "LlvmNative", expression.text(), expression.argumentIndexes().length());

        if (method.isMissing()) {
            return backend.int32(0);
        }

        ArrayList<LlvmType> parameterTypes = ArrayList();
        ArrayList<LlvmValue> arguments = ArrayList();
        Int index = 0;

        while (index < method.parameters().length()) {
            String typeName = method.parameters().get(index).typeName();
            LlvmValue argument = this.expressions.emit(expression.argumentIndexes().get(index), program, backend, locals);

            if (typeName == "Bool") {
                parameterTypes.add(backend.context().int32Type());
                arguments.add(backend.builder().zeroExtend(argument, backend.context().int32Type(), "llvm_bool_arg_" + this.context.nextTemp().toString()));
            } else if (typeName == "Int" && expression.textIs("constInt") && index == 1) {
                parameterTypes.add(backend.context().int64Type());
                arguments.add(LlvmValue(argument.handle()));
            } else if (typeName == "Int") {
                parameterTypes.add(backend.context().int32Type());
                arguments.add(LlvmValue(argument.handle()));
            } else {
                parameterTypes.add(backend.context().opaquePointerType());
                arguments.add(LlvmValue(argument.handle()));
            }

            index = index + 1;
        }

        LlvmType returnType = this.bridgeReturnType(method.returnTypeName(), backend);
        LlvmRuntimeFunction function = backend.runtimeDeclarations().declare(this.nativeName(expression.text()), returnType, parameterTypes);
        String resultName = "llvm_bridge_" + this.context.nextTemp().toString();

        if (method.returnTypeName() == "Void") {
            resultName = "";
        }

        LlvmValue result = backend.callRuntime(function, arguments, resultName);

        if (method.returnTypeName() == "Bool") {
            return backend.builder().intNotEqual(result, backend.int32(0), "llvm_bool_" + this.context.nextTemp().toString());
        }

        if (method.returnTypeName() == "Void") {
            return backend.int32(0);
        }

        return result;
    }

    private LlvmType bridgeReturnType(String typeName, LlvmNativeBackend backend) {
        if (typeName == "Void") {
            return backend.context().voidType();
        }

        if (typeName == "Bool" || typeName == "Int") {
            return backend.context().int32Type();
        }

        return backend.context().opaquePointerType();
    }

    private String nativeName(String method) {
        if (method == "constIntegerText") { return "emerald_llvm_const_integer_text"; }
        if (method == "constFloatText") { return "emerald_llvm_const_float_text"; }
        if (method == "buildExtractValue") { return "emerald_llvm_build_extract_value"; }
        if (method == "buildFloatOperation") { return "emerald_llvm_build_float_operation"; }

        if (method == "initializeNativeTarget") {
            return "emerald_llvm_initialize_native_target";
        }

