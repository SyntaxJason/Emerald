namespace emerald::compiler::hyperallocflow;

use emerald::compiler::diagnostic::DiagnosticBag;

public class HyperAllocFlowStrictValidator {
    public HyperAllocFlowStrictValidator() {
    }

    public Void validate(HyperAllocFlowReport report, DiagnosticBag diagnostics) {
        Int index = 0;

        while (index < report.decisions().length()) {
            HyperAllocFlowDecision decision = report.decisions().get(index);

            if (decision.isStrictIssue()) {
                diagnostics.error(this.message(decision), decision.line(), decision.column());
            }

            index = index + 1;
        }
    }

    private String message(HyperAllocFlowDecision decision) {
        return "Flow strict rejected unresolved " + decision.kind().name() + " allocation for " + decision.typeName() + ": " + decision.strictReason();
    }
}
