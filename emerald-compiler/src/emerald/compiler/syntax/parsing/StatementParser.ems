namespace emerald::compiler::syntax;

public class StatementParser {
    private ParserState state;
    private SimpleStatementParser simple;
    private ControlStatementParser control;

    public StatementParser(ParserState parserState) {
        this.state = parserState;
        this.simple = SimpleStatementParser(parserState);
        this.control = ControlStatementParser(parserState);
    }

    public List<Statement> parseBlockStatements() {
        List<Statement> statements = List();
        this.state.consumeSymbol("{", "Expected '{' before block");

        while (!this.state.isAtEnd() && !this.state.checkSymbol("}")) {
            Statement statement = this.parseStatement();

            if (!statement.isMissing()) {
                statements.add(statement);
            }
        }

        this.state.consumeSymbol("}", "Expected '}' after block");
        return statements;
    }

    public Statement parseStatement() {
        if (this.state.current().isIdentifier("println")) {
            return this.simple.parsePrintln();
        }

        if (this.state.current().isIdentifier("return")) {
            return this.simple.parseReturn();
        }

        if (this.state.current().isIdentifier("break")) {
            return this.simple.parseBreak();
        }

        if (this.state.current().isIdentifier("continue")) {
            return this.simple.parseContinue();
        }

        if (this.state.current().isIdentifier("panic")) {
            return this.simple.parsePanic();
        }

        if (this.state.current().isIdentifier("if")) {
            return this.control.parseIf();
        }

        if (this.state.current().isIdentifier("while")) {
            return this.control.parseWhile();
        }

        if (this.state.current().isIdentifier("for")) {
            return this.control.parseFor();
        }

        if (this.isVariableStart()) {
            return this.simple.parseVariable();
        }

        if (this.state.current().kindIs("identifier") && this.state.peek(1).textIs("=")) {
            return this.simple.parseAssign();
        }

        if (this.isFieldAssignStart()) {
            return this.simple.parseFieldAssign();
        }

        if (this.isExpressionStatementStart()) {
            return this.simple.parseExpressionStatement();
        }

        Token token = this.state.current();
        this.state.diagnostics().error("Expected statement", token.line(), token.column());
        this.state.synchronize();

        return this.state.missingStatement(token.line(), token.column());
    }

    private Bool isVariableStart() {
        if (!this.state.current().kindIs("identifier")) {
            return false;
        }

        Int nameOffset = this.variableNameOffset();

        if (!this.state.peek(nameOffset).kindIs("identifier")) {
            return false;
        }

        return this.state.peek(nameOffset + 1).textIs("=");
    }

    private Int variableNameOffset() {
        Int offset = this.skipType(0);
        return offset;
    }

    private Int skipType(Int offset) {
        offset = offset + 1;

        while (this.state.peek(offset).textIs("::")) {
            offset = offset + 1;

            if (this.state.peek(offset).kindIs("identifier")) {
                offset = offset + 1;
                continue;
            }

            return offset;
        }

        if (this.state.peek(offset).textIs("<")) {
            return this.skipGenericArguments(offset);
        }

        return offset;
    }

    private Int skipGenericArguments(Int offset) {
        Int depth = 0;

        while (!this.state.peek(offset).kindIs("eof")) {
            if (this.state.peek(offset).textIs("<")) {
                depth = depth + 1;
            }

            if (this.state.peek(offset).textIs(">")) {
                depth = depth - 1;
                offset = offset + 1;

                if (depth <= 0) {
                    return offset;
                }

                continue;
            }

            offset = offset + 1;
        }

        return offset;
    }

    private Bool isFieldAssignStart() {
        if (!this.state.current().kindIs("identifier")) {
            return false;
        }

        if (!this.state.peek(1).textIs(".")) {
            return false;
        }

        if (!this.state.peek(2).kindIs("identifier")) {
            return false;
        }

        return this.state.peek(3).textIs("=");
    }

    private Bool isExpressionStatementStart() {
        if (this.state.current().kindIs("identifier") || this.state.current().kindIs("number") || this.state.current().kindIs("string")) {
            return true;
        }

        if (this.state.checkSymbol("$") || this.state.checkSymbol("(") || this.state.checkSymbol("[") || this.state.checkSymbol("!") || this.state.checkSymbol("-")) {
            return true;
        }

        return false;
    }
}
