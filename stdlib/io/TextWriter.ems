namespace Std::Io;

use Std::Io::IClosable;
use Std::Io::IFlushable;
use Std::Io::IPath;
use Std::Io::ITextWriter;
use Std::Io::Path;
use Std::Native::NativeFile;
use Std::Result::Failure;
use Std::Result::BoolSuccess;
use Std::Result::IResult;
use Std::Result::Success;
use Std::Native::NativeSystem;

public class TextWriter implements ITextWriter, IClosable, IFlushable {
    private Path writerPath;

    public TextWriter(String path) {
        this.writerPath = Path(path);
    }

    public TextWriter(Path path) {
        this.writerPath = path;
    }

    public TextWriter(IPath path) {
        this.writerPath = Path(path.value());
    }

    public IPath path() {
        return this.writerPath;
    }

    public Bool exists() {
        return NativeFile.exists(this.writerPath.value());
    }

    public Void writeText(String text) {
        NativeFile.writeText(this.writerPath.value(), text);
    }

    public Void writeLine(String text) {
        this.writeText(text + NativeSystem.lineSeparator());
    }

    public IResult<Bool, String> tryWriteText(String text) {
        NativeFile.writeText(this.writerPath.value(), text);

        if (!this.exists()) {
            return Failure("Could not write file: " + this.writerPath.value());
        }

        return BoolSuccess(true);
    }

    public IResult<Bool, String> tryWriteLine(String text) {
        return this.tryWriteText(text + NativeSystem.lineSeparator());
    }

    public Void appendText(String text) {
        NativeFile.appendText(this.writerPath.value(), text);
    }

    public Void appendLine(String text) {
        this.appendText(text + NativeSystem.lineSeparator());
    }

    public IResult<Bool, String> tryAppendText(String text) {
        NativeFile.appendText(this.writerPath.value(), text);

        if (!this.exists()) {
            return Failure("Could not append file: " + this.writerPath.value());
        }

        return BoolSuccess(true);
    }

    public IResult<Bool, String> tryAppendLine(String text) {
        return this.tryAppendText(text + NativeSystem.lineSeparator());
    }

    public Void flush() {
    }

    public Void close() {
    }
}
