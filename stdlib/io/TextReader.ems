namespace Std::Io;

use Std::Collections::ArrayList;
use Std::Collections::IList;
use Std::Io::IClosable;
use Std::Io::IPath;
use Std::Io::ITextReader;
use Std::Io::Path;
use Std::Native::NativeFile;
use Std::Result::Failure;
use Std::Result::IResult;
use Std::Result::Success;

public class TextReader implements ITextReader, IClosable {
    private Path readerPath;

    public TextReader(String path) {
        this.readerPath = Path(path);
    }

    public TextReader(Path path) {
        this.readerPath = path;
    }

    public TextReader(IPath path) {
        this.readerPath = Path(path.value());
    }

    public IPath path() {
        return this.readerPath;
    }

    public Bool exists() {
        return NativeFile.exists(this.readerPath.value());
    }

    public String readText() {
        return NativeFile.readText(this.readerPath.value());
    }

    public String readOr(String fallback) {
        if (!this.exists()) {
            return fallback;
        }

        return this.readText();
    }

    public IList<String> readLines() {
        return ArrayList(NativeFile.readLines(this.readerPath.value()));
    }

    public IResult<String, String> tryReadText() {
        if (!this.exists()) {
            return Failure("File does not exist: " + this.readerPath.value());
        }

        return Success(this.readText());
    }

    public Void close() {
    }
}
