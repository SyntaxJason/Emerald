namespace Std::Io;

use Std::Io::Consoles;
use Std::Io::IConsole;
use Std::Result::IResult;

public class Console implements IConsole {
    public Console() {
    }

    public Void write(String text) {
        Consoles.write(text);
    }

    public Void writeLine(String text) {
        Consoles.writeLine(text);
    }

    public Void errorLine(String text) {
        Consoles.errorLine(text);
    }

    public Void blankLine() {
        Consoles.blankLine();
    }

    public String readLine() {
        return Consoles.readLine();
    }

    public String readLineOr(String fallback) {
        return Consoles.readLineOr(fallback);
    }

    public IResult<String, String> tryReadLine() {
        return Consoles.tryReadLine();
    }

    public String prompt(String message) {
        this.write(message);
        return this.readLine();
    }

    public String promptOr(String message, String fallback) {
        this.write(message);
        return this.readLineOr(fallback);
    }

    public Bool confirm(String question) {
        return this.confirmOr(question, false);
    }

    public Bool confirmOr(String question, Bool fallback) {
        this.write(question);
        String answer = this.readLine();
        String normalized = answer.toLowerCase();

        if (normalized.equals("y")) {
            return true;
        }

        if (normalized.equals("yes")) {
            return true;
        }

        if (normalized.equals("j")) {
            return true;
        }

        if (normalized.equals("ja")) {
            return true;
        }

        if (normalized.equals("n")) {
            return false;
        }

        if (normalized.equals("no")) {
            return false;
        }

        if (normalized.equals("nein")) {
            return false;
        }

        return fallback;
    }
}
