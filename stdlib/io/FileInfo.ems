namespace Std::Io;

use Std::Io::IFileInfo;
use Std::Io::IPath;
use Std::Io::Path;
use Std::Native::NativeDirectory;
use Std::Native::NativeFile;

public class FileInfo implements IFileInfo {
    private Path infoPath;

    public FileInfo(String path) {
        this.infoPath = Path(path);
    }

    public FileInfo(Path path) {
        this.infoPath = path;
    }

    public FileInfo(IPath path) {
        this.infoPath = Path(path.value());
    }

    public IPath path() {
        return this.infoPath;
    }

    public String name() {
        return this.infoPath.fileName();
    }

    public Bool exists() {
        if (NativeFile.exists(this.infoPath.value())) {
            return true;
        }

        return NativeDirectory.exists(this.infoPath.value());
    }

    public Bool isMissing() {
        return !this.exists();
    }

    public Bool isFile() {
        return NativeFile.isFile(this.infoPath.value());
    }

    public Bool isDirectory() {
        return NativeDirectory.exists(this.infoPath.value());
    }

    public Int size() {
        return NativeFile.size(this.infoPath.value());
    }
}
