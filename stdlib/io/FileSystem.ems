namespace Std::Io;

use Std::Io::Directory;
use Std::Io::File;
use Std::Io::FileInfo;
use Std::Io::IDirectory;
use Std::Io::IFile;
use Std::Io::IFileInfo;
use Std::Io::IFileSystem;
use Std::Io::IPath;
use Std::Io::Path;
use Std::Io::Paths;

public class FileSystem implements IFileSystem {
    public FileSystem() {
    }

    public IPath path(String value) {
        return Path(value);
    }

    public IPath currentPath() {
        return Paths.current();
    }

    public IPath workingDirectory() {
        return this.currentPath();
    }

    public IFile file(String value) {
        return File(value);
    }

    public IFile fileAt(IPath path) {
        return File(path);
    }

    public IFile fileInWorkingDirectory(String name) {
        return this.fileAt(this.workingDirectory().join(name));
    }

    public IDirectory directory(String value) {
        return Directory(value);
    }

    public IDirectory directoryAt(IPath path) {
        return Directory(path);
    }

    public IDirectory directoryInWorkingDirectory(String name) {
        return this.directoryAt(this.workingDirectory().join(name));
    }

    public IFileInfo info(String value) {
        return FileInfo(value);
    }

    public IFileInfo infoAt(IPath path) {
        return FileInfo(path);
    }
}
