namespace Std::Io;

use Std::Collections::IList;
use Std::Io::FileInfo;
use Std::Io::Files;
use Std::Io::IFile;
use Std::Io::IFileInfo;
use Std::Io::IPath;
use Std::Io::ITextReader;
use Std::Io::ITextWriter;
use Std::Io::Path;
use Std::Io::TextReader;
use Std::Io::TextWriter;
use Std::Native::NativeDirectory;
use Std::Result::IResult;
use Std::Native::NativeSystem;

public class File implements IFile {
    private Path filePath;

    public File(String path) {
        this.filePath = Path(path);
    }

    public File(Path path) {
        this.filePath = path;
    }

    public File(IPath path) {
        this.filePath = Path(path.value());
    }

    public IPath path() {
        return this.filePath;
    }

    public String name() {
        return this.filePath.fileName();
    }

    public Bool exists() {
        return Files.exists(this.filePath.value());
    }

    public Bool isFile() {
        return Files.isFile(this.filePath.value());
    }

    public Bool isDirectory() {
        return NativeDirectory.exists(this.filePath.value());
    }

    public String readText() {
        return Files.readText(this.filePath.value());
    }

    public String readOr(String fallback) {
        if (!this.exists()) {
            return fallback;
        }

        return this.readText();
    }

    public IList<String> readLines() {
        return Files.readLines(this.filePath.value());
    }

    public IResult<String, String> tryReadText() {
        return Files.tryReadText(this.filePath.value());
    }

    public Void writeText(String text) {
        Files.writeText(this.filePath.value(), text);
    }

    public Void writeLine(String text) {
        this.writeText(text + NativeSystem.lineSeparator());
    }

    public IResult<Bool, String> tryWriteText(String text) {
        return Files.tryWriteText(this.filePath.value(), text);
    }

    public IResult<Bool, String> tryWriteLine(String text) {
        return this.tryWriteText(text + NativeSystem.lineSeparator());
    }

    public Void appendText(String text) {
        Files.appendText(this.filePath.value(), text);
    }

    public Void appendLine(String text) {
        this.appendText(text + NativeSystem.lineSeparator());
    }

    public IResult<Bool, String> tryAppendText(String text) {
        return Files.tryAppendText(this.filePath.value(), text);
    }

    public IResult<Bool, String> tryAppendLine(String text) {
        return this.tryAppendText(text + NativeSystem.lineSeparator());
    }

    public Bool delete() {
        return Files.delete(this.filePath.value());
    }

    public Bool deleteIfExists() {
        if (!this.exists()) {
            return true;
        }

        return this.delete();
    }

    public Void clear() {
        this.writeText("");
    }

    public Bool ensureParentDirectory() {
        return NativeDirectory.create(this.filePath.parent().value());
    }

    public Int size() {
        return Files.size(this.filePath.value());
    }

    public IFileInfo info() {
        return FileInfo(this.filePath.value());
    }

    public ITextReader reader() {
        return TextReader(this.filePath.value());
    }

    public ITextWriter writer() {
        return TextWriter(this.filePath.value());
    }
}
