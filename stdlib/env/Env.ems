namespace Std::Env;

use Std::Env::Environment;
use Std::Env::IEnvironment;
use Std::Native::NativeEnv;

public class Env {
    public Env() {
    }

    public static String get(String name) {
        return NativeEnv.get(name);
    }

    public static String getOr(String name, String fallback) {
        return NativeEnv.getOr(name, fallback);
    }

    public static Bool has(String name) {
        return NativeEnv.has(name);
    }

    public static List<String> args() {
        return NativeEnv.args();
    }

    public static String currentDirectory() {
        return NativeEnv.currentDirectory();
    }

    public IEnvironment current() {
        return Environment();
    }
}
