namespace Std::Env;

use Std::Env::IEnvironment;
use Std::Native::NativeEnv;

public class Environment implements IEnvironment {
    public Environment() {
    }

    public String get(String name) {
        return NativeEnv.get(name);
    }

    public String getOr(String name, String fallback) {
        return NativeEnv.getOr(name, fallback);
    }

    public Bool has(String name) {
        return NativeEnv.has(name);
    }

    public List<String> args() {
        return NativeEnv.args();
    }

    public String currentDirectory() {
        return NativeEnv.currentDirectory();
    }
}
