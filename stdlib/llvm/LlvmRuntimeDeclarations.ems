namespace Std::Llvm;

use Std::Collections::ArrayList;
use Std::Collections::IList;

public class LlvmRuntimeDeclarations {
    private LlvmContext context;
    private LlvmModule llvmModule;

    public LlvmRuntimeDeclarations(LlvmContext context, LlvmModule llvmModule) {
        this.context = LlvmContext(context.handle());
        this.llvmModule = LlvmModule(llvmModule.handle(), llvmModule.context());
    }

