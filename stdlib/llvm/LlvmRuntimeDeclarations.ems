    public LlvmRuntimeFunction declare(String name, LlvmType returnType, IList<LlvmType> parameterTypes) {
        LlvmType functionType = this.context.functionTypeWithParams(returnType, parameterTypes);
        LlvmFunction existing = this.llvmModule.getFunction(name);

        if (!existing.isNull()) {
            return LlvmRuntimeFunction(functionType, existing);
        }

        LlvmFunction declared = this.llvmModule.addFunction(name, functionType);
        declared.setLinkage(Llvm.externalLinkage());

        return LlvmRuntimeFunction(functionType, declared);
    }

    private LlvmType pointerType() {
        return this.context.opaquePointerType();
    }
}
