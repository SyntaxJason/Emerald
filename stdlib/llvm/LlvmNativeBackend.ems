    public LlvmValue callRuntime(LlvmRuntimeFunction runtimeFunction, IList<LlvmValue> args, String name) {
        ArrayList<LlvmValue> adapted = ArrayList();
        Int index = 0;
        while (index < args.size()) {
            LlvmValue value = LlvmValue(args.get(index).handle());
            adapted.add(this.adaptRuntimeValue(value, runtimeFunction.function().parameter(index).type(), name));
            index = index + 1;
        }
        return this.builderValue.callFunction(runtimeFunction.type(), runtimeFunction.function(), adapted, name);
    }

    public Bool verify() {
        this.finalizeStaticLiterals();
        if (this.llvmModule.verify()) {
            return true;
        }

        this.lastBackendMessage = this.llvmModule.verifyMessage();
        return false;
    }

    public Bool writeIr(String path) {
        this.finalizeStaticLiterals();
        this.prepareParentDirectory(path);

        if (this.llvmModule.writeIr(path)) {
            return true;
        }

        this.lastBackendMessage = "Failed to write LLVM IR";
        return false;
    }

    public Bool emitObject() {
        if (!this.validateBuildOptimization()) { return false; }
        if (this.buildLtoMode() != "off" || !this.profileGeneratePath().isEmpty() || !this.profileUsePath().isEmpty()) {
            // Clang receives LLVM IR, not a precompiled machine-code object;
            // this makes Runtime + Emerald Stdlib definitions visible to LTO.
            if (this.profileGeneratePath().isEmpty() && this.profileUsePath().isEmpty()) {
                this.runOptimizationPasses();
            } else {
                this.llvmModule.runPasses("verify");
            }
            String path = this.tempBaseValue + "/module.ll";
            this.prepareParentDirectory(path);
            if (!this.llvmModule.writeIr(path)) { this.lastBackendMessage = "Could not write LLVM IR for optimized build."; return false; }
            ArrayList<String> extraArgs = this.targetExtraArgs();
            this.addBuildOptimizationArgs(extraArgs, false);
            if (!this.ccValue.isEmpty()) { extraArgs.add("--emerald-cc=" + this.ccValue); }
            if (LlvmNative.compileIrObject(path, this.objectPath(), extraArgs)) { return true; }
            this.lastBackendMessage = LlvmNative.runtimeLastCommand() + LlvmNative.runtimeLastOutput() + LlvmNative.runtimeLastError();
            return false;
        }
        this.runOptimizationPasses();

        if (this.llvmModule.emitObjectFileFor(this.targetTripleValue, this.objectPath())) {
            return true;
        }

        this.lastBackendMessage = Llvm.lastError();
        return false;
    }

    private Void runOptimizationPasses() {
        String passes = Env.getOr("EMERALD_LLVM_PASSES", "default<O2>");

        if (passes.isEmpty() || passes == "none") {
            return;
        }

        this.llvmModule.runPasses(passes);
    }

    public Bool emitObjectOutput() {
        if (!this.verify()) {
            return false;
        }

        this.prepareParentDirectory(this.objectPath());
        return this.emitObject();
    }

    public Bool emitAssemblyOutput() {
        if (!this.verify()) {
            return false;
        }

        this.prepareParentDirectory(this.assemblyPath());
        this.runOptimizationPasses();

        if (this.llvmModule.emitAssemblyFileFor(this.targetTripleValue, this.assemblyPath())) {
            return true;
        }

        this.lastBackendMessage = Llvm.lastError();
        return false;
    }

    public Bool prepareTempDirectory() {
        this.prepareParentDirectory(this.tempBaseValue);

        if (this.keepTempsValue) {
            return true;
        }

        NativeDirectory.create(this.tempBaseValue);
        return true;
    }

    public Bool cleanupTempDirectory() {
        if (this.keepTempsValue) {
            return true;
        }

        NativeFile.delete(this.objectPath());
        NativeFile.delete(this.runtimeObjectPath());
        NativeFile.delete(this.tempBaseValue + "/module.ll");
        NativeDirectory.delete(this.tempBaseValue);
        return true;
    }

    public Bool compileRuntime() {
        ArrayList<String> extraArgs = this.targetExtraArgs();
        this.addLlvmRuntimeCompileArgs(extraArgs);
        this.addBuildOptimizationArgs(extraArgs, false);

        if (!this.ccValue.isEmpty()) {
            extraArgs.add("--emerald-cc=" + this.ccValue);
        }

        if (this.runtimeValue.compileObjectWith(this.runtimeObjectPath(), extraArgs)) {
            return true;
        }

        this.lastBackendMessage = this.runtimeValue.lastCommand() + this.runtimeValue.lastOutput() + this.runtimeValue.lastError();
        return false;
    }

    public Bool linkExecutable() {
        this.prepareParentDirectory(this.executablePath());

        ArrayList<String> objects = ArrayList();
        objects.add(this.objectPath());
        objects.add(this.runtimeObjectPath());

        IList<String> libraryPaths = this.runtimeValue.libraryPaths();
        IList<String> libraries = this.runtimeLibrariesForTarget();
        ArrayList<String> extraArgs = this.targetExtraArgs();

        if (!this.ccValue.isEmpty()) {
            extraArgs.add("--emerald-cc=" + this.ccValue);
        }

        if (this.targetNameValue == "windows-x64") {
            extraArgs.add("-lws2_32");
            extraArgs.add("-luser32");
            extraArgs.add("-lgdi32");
            extraArgs.add("-lshell32");
            extraArgs.add("-lole32");
        }

        if (this.targetNameValue == "native" || this.targetNameValue == "linux-x64" || this.targetNameValue == "linux-arm64") {
            extraArgs.add("-ldl");
            if (this.mathLibraryRequiredValue) { extraArgs.add("-lm"); }
        }

        this.addLlvmRuntimeLinkArgs(extraArgs);
        this.addBuildOptimizationArgs(extraArgs, true);

        if (this.linkerValue.linkExecutableWith(this.executablePath(), objects, libraryPaths, libraries, extraArgs)) {
            return true;
        }

        this.lastBackendMessage = this.linkerValue.lastCommand() + this.linkerValue.lastOutput() + this.linkerValue.lastError();
        return false;
    }

    public Bool buildExecutable() {
        if (!this.verify()) {
            return false;
        }

        if (!this.prepareTempDirectory()) {
            return false;
        }

        if (!this.emitObject()) {
            this.cleanupTempDirectory();
            return false;
        }

        if (!this.compileRuntime()) {
            this.cleanupTempDirectory();
            return false;
        }

        if (!this.linkExecutable()) {
            this.cleanupTempDirectory();
            return false;
        }

        this.cleanupTempDirectory();
        return true;
    }


    private String profileGeneratePath() { return Env.getOr("EMERALD_PGO_GENERATE", ""); }
    private String profileUsePath() { return Env.getOr("EMERALD_PGO_USE", ""); }

    private String buildCc() {
        if (!this.ccValue.isEmpty()) { return this.ccValue; }
        return Env.getOr("EMERALD_CC", Env.getOr("CC", "clang"));
    }

    private String buildLtoMode() {
        String mode = Env.getOr("EMERALD_LTO", "auto");
        if (mode == "auto") {
            if (this.targetNameValue == "native" && this.targetTripleValue.contains("linux") && this.buildCc().contains("clang")) { return "thin"; }
            return "off";
        }
        if (mode == "0" || mode.isEmpty()) { return "off"; }
        if (mode == "1") { return "thin"; }
        return mode;
    }

    private Bool validateBuildOptimization() {
        String mode = this.buildLtoMode();
        if (mode != "off" && mode != "thin" && mode != "full") {
            this.lastBackendMessage = "EMERALD_LTO must be auto, off, thin or full";
            return false;
        }
        if (!this.profileGeneratePath().isEmpty() && !this.profileUsePath().isEmpty()) {
            this.lastBackendMessage = "Choose either EMERALD_PGO_GENERATE or EMERALD_PGO_USE";
            return false;
        }
        if ((mode != "off" || !this.profileGeneratePath().isEmpty() || !this.profileUsePath().isEmpty()) && !this.buildCc().contains("clang")) {
            this.lastBackendMessage = "Emerald LTO/PGO requires Clang; EMERALD_LTO=off preserves other C compilers";
            return false;
        }
        return true;
    }

    private Void addBuildOptimizationArgs(ArrayList<String> args, Bool linking) {
        String mode = this.buildLtoMode();
        if (mode != "off") {
            args.add("-flto=" + mode);
            String linker = Env.getOr("EMERALD_LTO_LINKER", "");
            if (linking && !linker.isEmpty()) { args.add("-fuse-ld=" + linker); }
        }
        String generate = this.profileGeneratePath();
        String profile = this.profileUsePath();
        if (!generate.isEmpty()) { args.add("-fprofile-generate=" + generate); }
        if (!profile.isEmpty()) { args.add("-fprofile-use=" + profile); }
    }

    private Void addLlvmRuntimeCompileArgs(ArrayList<String> extraArgs) {
        if (!this.llvmBridgeValue) {
            return;
        }

        extraArgs.add("-DEMERALD_RUNTIME_ENABLE_LLVM=1");
    }

    private Void addLlvmRuntimeLinkArgs(ArrayList<String> extraArgs) {
        if (!this.llvmBridgeValue) {
            return;
        }

        String libraryPath = Env.getOr("EMERALD_LLVM_LIB_DIR", "");

        if (!libraryPath.isEmpty()) {
            extraArgs.add("-L" + libraryPath);
        }

        String library = Env.getOr("EMERALD_LLVM_LIBRARY", "LLVM");
        extraArgs.add("-l" + library);
    }

    private ArrayList<String> targetExtraArgs() {
        ArrayList<String> args = ArrayList();
        args.add("--emerald-target=" + this.targetNameValue);

        if (this.shouldPassTargetToCc()) {
            args.add("--target=" + this.targetTripleValue);
        }

        if (!this.sysrootValue.isEmpty()) {
            args.add("--sysroot=" + this.sysrootValue);
        }

        return args;
    }

    private Bool shouldPassTargetToCc() {
        if (this.targetNameValue == "native") {
            return false;
        }

        if (this.ccValue.isEmpty()) {
            return true;
        }

        if (this.ccValue.contains("clang")) {
            return true;
        }

        if (this.ccValue.contains("gcc")) {
            return false;
        }

        return true;
    }

    private IList<String> runtimeLibrariesForTarget() {
        if (this.targetNameValue == "windows-x64") {
            ArrayList<String> result = ArrayList();
            return result;
        }

        return this.runtimeValue.libraries();
    }

    public Void dispose() {
        this.builderValue.dispose();
        this.llvmModule.dispose();
        this.contextValue.dispose();
    }

    private ArrayList<LlvmValue> emptyValues() {
        return ArrayList();
    }
    public LlvmValue floatLiteral(String text) {
        return LlvmValue(LlvmNative.constFloatText(this.contextValue.doubleType().handle(), text));
    }

    public LlvmValue floatToString(LlvmValue value, String name) {
        ArrayList<LlvmType> params = ArrayList();
        params.add(this.contextValue.doubleType());
        ArrayList<LlvmValue> args = ArrayList();
        args.add(LlvmValue(value.handle()));
        return this.callRuntime(this.runtimeDeclarationsValue.declare("emerald_float64_to_string", this.contextValue.opaquePointerType(), params), args, name);
    }

    public LlvmValue checkedInteger(String operation, LlvmValue left, LlvmValue right, String name) {
        ArrayList<LlvmType> params = ArrayList();
        params.add(this.contextValue.int64Type());
        if (operation != "neg") { params.add(this.contextValue.int64Type()); }
        LlvmType type = this.contextValue.functionTypeWithParams(this.contextValue.int64Type(), params);
        String helperName = "__emerald_checked_" + operation;
        LlvmFunction helper = this.llvmModule.getFunction(helperName);
        if (helper.isNull()) {
            LlvmFunction created = this.llvmModule.addFunction(helperName, type);
            created.setLinkage(Llvm.internalLinkage());
            this.defineCheckedInteger(created, operation, params);
        }
        ArrayList<LlvmValue> args = ArrayList();
        args.add(LlvmValue(left.handle()));
        if (operation != "neg") { args.add(LlvmValue(right.handle())); }
        return this.builderValue.callFunction(type, this.llvmModule.getFunction(helperName), args, name);
    }

    // Small internal helpers let LLVM inline and prove arithmetic checks while
    // keeping exact Int semantics and the existing diagnostic on the cold path.
    private Void defineCheckedInteger(LlvmFunction function, String operation, ArrayList<LlvmType> params) {
        LlvmBuilder builder = this.contextValue.createBuilder();
        LlvmBasicBlock entry = function.appendBlock("entry");
        LlvmBasicBlock failed = function.appendBlock("failed");
        LlvmBasicBlock success = function.appendBlock("success");
        builder.positionAtEnd(entry);
        LlvmValue left = function.parameter(0);
        Int rightHandle = this.int64(0).handle();
        if (operation != "neg") { rightHandle = function.parameter(1).handle(); }
        LlvmValue right = LlvmValue(rightHandle);
        Int resultHandle = this.int64(0).handle();
        if (operation == "add" || operation == "sub" || operation == "mul" || operation == "neg") {
            ArrayList<LlvmType> pair = ArrayList();
            pair.add(this.contextValue.int64Type());
            pair.add(this.contextValue.boolType());
            LlvmType returnType = this.contextValue.structType(pair, false);
            ArrayList<LlvmType> inputTypes = ArrayList();
            inputTypes.add(this.contextValue.int64Type());
            inputTypes.add(this.contextValue.int64Type());
            String intrinsicName = "llvm.s" + operation + ".with.overflow.i64";
            if (operation == "neg") { intrinsicName = "llvm.ssub.with.overflow.i64"; }
            LlvmRuntimeFunction intrinsic = this.runtimeDeclarationsValue.declare(intrinsicName, returnType, inputTypes);
            ArrayList<LlvmValue> inputs = ArrayList();
            if (operation == "neg") {
                inputs.add(this.int64(0));
                inputs.add(LlvmValue(left.handle()));
            } else {
                inputs.add(LlvmValue(left.handle()));
                inputs.add(LlvmValue(right.handle()));
            }
            LlvmValue checked = builder.callFunction(intrinsic.type(), intrinsic.function(), inputs, "checked");
            resultHandle = builder.extractValue(checked, 0, "value").handle();
            LlvmValue overflow = builder.extractValue(checked, 1, "overflow");
            builder.conditionalBranch(overflow, failed, success);
        } else {
            LlvmValue zero = builder.intEqual(right, this.int64(0), "zero");
            LlvmValue minimum = builder.intEqual(left, LlvmValue(LlvmNative.constIntegerText(this.contextValue.int64Type().handle(), "-9223372036854775808")), "minimum");
            LlvmValue minusOne = builder.intEqual(right, this.int64(-1), "minus_one");
            LlvmValue exceptional = builder.bitAnd(minimum, minusOne, "exceptional");
            if (operation == "div") {
                builder.conditionalBranch(builder.bitOr(zero, exceptional, "invalid"), failed, success);
            } else {
                // MIN % -1 is defined as zero; never emit LLVM srem on that
                // pair, because LLVM treats it as poison just like sdiv.
                LlvmBasicBlock nonZero = function.appendBlock("non_zero");
                LlvmBasicBlock remainderZero = function.appendBlock("remainder_zero");
                builder.conditionalBranch(zero, failed, nonZero);
                builder.positionAtEnd(nonZero);
                builder.conditionalBranch(exceptional, remainderZero, success);
                builder.positionAtEnd(remainderZero);
                builder.returnValue(this.int64(0));
            }
        }
        builder.positionAtEnd(failed);
        LlvmRuntimeFunction fallback = this.runtimeDeclarationsValue.declare("emerald_int64_" + operation, this.contextValue.int64Type(), params);
        ArrayList<LlvmValue> failedArgs = ArrayList();
        failedArgs.add(LlvmValue(left.handle()));
        if (operation != "neg") { failedArgs.add(LlvmValue(right.handle())); }
        builder.callFunction(fallback.type(), fallback.function(), failedArgs, "diagnostic");
        builder.unreachable();
        builder.positionAtEnd(success);
        if (operation == "div") { resultHandle = builder.signedDiv(left, right, "value").handle(); }
        if (operation == "rem") { resultHandle = builder.signedRem(left, right, "value").handle(); }
        builder.returnValue(LlvmValue(resultHandle));
        builder.dispose();
    }

    // Payload layouts shared with runtime/emerald_runtime.h. Only payload
    // fields are read here; the Flow block header is never touched.
    private LlvmType listStructType() {
        if (this.listStructHandle == 0) {
            LlvmType type = this.contextValue.namedStructType("EmeraldList");
            ArrayList<LlvmType> fields = ArrayList();
            fields.add(this.contextValue.int64Type());
            fields.add(this.contextValue.int64Type());
            fields.add(this.contextValue.opaquePointerType());
            fields.add(this.contextValue.opaquePointerType());
            fields.add(this.contextValue.int64Type());
            fields.add(this.contextValue.int32Type());
            type.setStructBody(fields, false);
            this.listStructHandle = type.handle();
        }

        return LlvmType(this.listStructHandle);
    }

    private LlvmType stringStructType() {
        if (this.stringStructHandle == 0) {
            LlvmType type = this.contextValue.namedStructType("EmeraldString");
            ArrayList<LlvmType> fields = ArrayList();
            fields.add(this.contextValue.int64Type());
            fields.add(this.contextValue.opaquePointerType());
            type.setStructBody(fields, false);
            this.stringStructHandle = type.handle();
        }

        return LlvmType(this.stringStructHandle);
    }

    private LlvmValue structFieldPointer(LlvmBuilder builder, LlvmType structType, LlvmValue pointer, Int field, String name) {
        ArrayList<LlvmValue> indices = ArrayList();
        indices.add(this.int32(0));
        indices.add(this.int32(field));
        return builder.inboundsGep(structType, pointer, indices, name);
    }

    private LlvmRuntimeFunction helperFunction(String name, LlvmType returnType, ArrayList<LlvmType> params) {
        LlvmType type = this.contextValue.functionTypeWithParams(returnType, params);
        return LlvmRuntimeFunction(type, this.llvmModule.getFunction(name));
    }

    private LlvmFunction createHelper(String name, LlvmType returnType, ArrayList<LlvmType> params) {
        LlvmType type = this.contextValue.functionTypeWithParams(returnType, params);
        LlvmFunction created = this.llvmModule.addFunction(name, type);
        created.setLinkage(Llvm.internalLinkage());
        return created;
    }

    private ArrayList<LlvmType> pointerParams(Int extraInt64, Bool trailingPointer) {
        ArrayList<LlvmType> params = ArrayList();
        params.add(this.contextValue.opaquePointerType());
        Int index = 0;
        while (index < extraInt64) {
            params.add(this.contextValue.int64Type());
            index = index + 1;
        }
        if (trailingPointer) { params.add(this.contextValue.opaquePointerType()); }
        return params;
    }

    // Shared by lists and strings: both payloads start with a u64 length, and
    // a null receiver behaves as empty exactly like the runtime functions.
    private LlvmRuntimeFunction lengthHelper(String helperName, LlvmType structType) {
        ArrayList<LlvmType> params = this.pointerParams(0, false);
        if (this.llvmModule.getFunction(helperName).isNull()) {
            LlvmFunction function = this.createHelper(helperName, this.contextValue.int64Type(), params);
            LlvmBuilder builder = this.contextValue.createBuilder();
            LlvmBasicBlock entry = function.appendBlock("entry");
            LlvmBasicBlock empty = function.appendBlock("empty");
            LlvmBasicBlock present = function.appendBlock("present");
            builder.positionAtEnd(entry);
            LlvmValue isNull = builder.intEqual(function.parameter(0), Llvm.constPointerNull(this.contextValue.opaquePointerType()), "is_null");
            builder.conditionalBranch(isNull, empty, present);
            builder.positionAtEnd(empty);
            builder.returnValue(this.int64(0));
            builder.positionAtEnd(present);
            LlvmValue lengthPointer = this.structFieldPointer(builder, structType, function.parameter(0), 0, "length_ptr");
            builder.returnValue(builder.load(this.contextValue.int64Type(), lengthPointer, "length"));
            builder.dispose();
        }
        return this.helperFunction(helperName, this.contextValue.int64Type(), params);
    }

    private LlvmRuntimeFunction listLengthHelper() {
        return this.lengthHelper("__emerald_list_length", this.listStructType());
    }

    private LlvmRuntimeFunction stringLengthHelper() {
        return this.lengthHelper("__emerald_string_length", this.stringStructType());
    }

    // Out-of-range list indexes panic with the index and length; this is the
    // only (cold) path that reaches the runtime from the inline accessors.
    private LlvmRuntimeFunction listIndexFailHelper() {
        String helperName = "__emerald_list_index_fail";
        ArrayList<LlvmType> params = ArrayList();
        params.add(this.contextValue.int64Type());
        params.add(this.contextValue.int64Type());
        if (this.llvmModule.getFunction(helperName).isNull()) {
            LlvmFunction function = this.createHelper(helperName, this.contextValue.voidType(), params);
            LlvmBuilder builder = this.contextValue.createBuilder();
            builder.positionAtEnd(function.appendBlock("entry"));
            LlvmValue prefix = this.helperStaticString(builder, "List index ", "index_prefix");
            LlvmValue middle = this.helperStaticString(builder, " is out of bounds for length ", "index_middle");
            LlvmValue indexText = this.helperCall(builder, this.runtimeDeclarationsValue.intToString(), function.parameter(0), "index_text");
            LlvmValue lengthText = this.helperCall(builder, this.runtimeDeclarationsValue.intToString(), function.parameter(1), "length_text");
            LlvmValue message = this.helperConcat(builder, this.helperConcat(builder, this.helperConcat(builder, prefix, indexText, "message_a"), middle, "message_b"), lengthText, "message");
            this.helperCall(builder, this.runtimeDeclarationsValue.panic(), message, "");
            builder.unreachable();
            builder.dispose();
        }
        return this.helperFunction(helperName, this.contextValue.voidType(), params);
    }

    private LlvmValue helperStaticString(LlvmBuilder builder, String text, String name) {
        return this.staticStringGlobal(text, name);
    }

    private LlvmValue helperCall(LlvmBuilder builder, LlvmRuntimeFunction target, LlvmValue argument, String name) {
        ArrayList<LlvmValue> args = ArrayList();
        args.add(LlvmValue(argument.handle()));
        return builder.callFunction(target.type(), target.function(), args, name);
    }

    private LlvmValue helperConcat(LlvmBuilder builder, LlvmValue left, LlvmValue right, String name) {
        LlvmRuntimeFunction concat = this.runtimeDeclarationsValue.stringConcat();
        ArrayList<LlvmValue> args = ArrayList();
        args.add(LlvmValue(left.handle()));
        args.add(LlvmValue(right.handle()));
        return builder.callFunction(concat.type(), concat.function(), args, name);
    }

    // Emits the shared prologue of the indexed list helpers: computes the
    // length, panics through the cold helper when the index is outside
    // [0, length) and leaves the builder in the in-bounds block with the slot
    // address of the requested element.
    private LlvmValue checkedListSlot(LlvmBuilder builder, LlvmFunction function, LlvmValue list, LlvmValue index) {
        LlvmBasicBlock inBounds = function.appendBlock("in_bounds");
        LlvmBasicBlock outside = function.appendBlock("out_of_bounds");
        LlvmRuntimeFunction length = this.listLengthHelper();
        LlvmValue size = this.helperCall(builder, length, list, "length");
        LlvmValue valid = builder.intUnsignedLessThan(index, size, "valid");
        builder.conditionalBranch(valid, inBounds, outside);
        builder.positionAtEnd(outside);
        LlvmRuntimeFunction fail = this.listIndexFailHelper();
        ArrayList<LlvmValue> failArgs = ArrayList();
        failArgs.add(LlvmValue(index.handle()));
        failArgs.add(LlvmValue(size.handle()));
        builder.callFunction(fail.type(), fail.function(), failArgs, "");
        builder.unreachable();
        builder.positionAtEnd(inBounds);
        LlvmValue itemsPointer = this.structFieldPointer(builder, this.listStructType(), list, 2, "items_ptr");
        LlvmValue items = builder.load(this.contextValue.opaquePointerType(), itemsPointer, "items");
        ArrayList<LlvmValue> slotIndex = ArrayList();
        slotIndex.add(LlvmValue(index.handle()));
        return builder.inboundsGep(this.contextValue.opaquePointerType(), items, slotIndex, "slot");
    }

    private LlvmRuntimeFunction listGetHelper() {
        String helperName = "__emerald_list_get";
        ArrayList<LlvmType> params = this.pointerParams(1, false);
        if (this.llvmModule.getFunction(helperName).isNull()) {
            LlvmFunction function = this.createHelper(helperName, this.contextValue.opaquePointerType(), params);
            LlvmBuilder builder = this.contextValue.createBuilder();
            builder.positionAtEnd(function.appendBlock("entry"));
            LlvmValue slot = this.checkedListSlot(builder, function, function.parameter(0), function.parameter(1));
            builder.returnValue(builder.load(this.contextValue.opaquePointerType(), slot, "value"));
            builder.dispose();
        }
        return this.helperFunction(helperName, this.contextValue.opaquePointerType(), params);
    }

    private LlvmRuntimeFunction listSetPrimitiveHelper() {
        String helperName = "__emerald_list_set_primitive";
        ArrayList<LlvmType> params = this.pointerParams(1, true);
        if (this.llvmModule.getFunction(helperName).isNull()) {
            LlvmFunction function = this.createHelper(helperName, this.contextValue.voidType(), params);
            LlvmBuilder builder = this.contextValue.createBuilder();
            builder.positionAtEnd(function.appendBlock("entry"));
            LlvmValue slot = this.checkedListSlot(builder, function, function.parameter(0), function.parameter(1));
            builder.store(function.parameter(2), slot);
            builder.returnVoid();
            builder.dispose();
        }
        return this.helperFunction(helperName, this.contextValue.voidType(), params);
    }

    // Same contract as emerald_string_char_at: an index outside the string
    // (or a null string) yields the NUL character.
    private LlvmRuntimeFunction stringCharAtHelper() {
        String helperName = "__emerald_string_char_at";
        ArrayList<LlvmType> params = this.pointerParams(1, false);
        if (this.llvmModule.getFunction(helperName).isNull()) {
            LlvmFunction function = this.createHelper(helperName, this.contextValue.int32Type(), params);
            LlvmBuilder builder = this.contextValue.createBuilder();
            LlvmBasicBlock entry = function.appendBlock("entry");
            LlvmBasicBlock inBounds = function.appendBlock("in_bounds");
            LlvmBasicBlock outside = function.appendBlock("out_of_bounds");
            builder.positionAtEnd(entry);
            LlvmValue size = this.helperCall(builder, this.stringLengthHelper(), function.parameter(0), "length");
            builder.conditionalBranch(builder.intUnsignedLessThan(function.parameter(1), size, "valid"), inBounds, outside);
            builder.positionAtEnd(outside);
            builder.returnValue(this.int32(0));
            builder.positionAtEnd(inBounds);
            LlvmValue bytesPointer = this.structFieldPointer(builder, this.stringStructType(), function.parameter(0), 1, "bytes_ptr");
            LlvmValue bytes = builder.load(this.contextValue.opaquePointerType(), bytesPointer, "bytes");
            ArrayList<LlvmValue> byteIndex = ArrayList();
            byteIndex.add(function.parameter(1));
            LlvmValue bytePointer = builder.inboundsGep(this.contextValue.int8Type(), bytes, byteIndex, "byte_ptr");
            LlvmValue byte = builder.load(this.contextValue.int8Type(), bytePointer, "byte");
            builder.returnValue(builder.zeroExtend(byte, this.contextValue.int32Type(), "char"));
            builder.dispose();
        }
        return this.helperFunction(helperName, this.contextValue.int32Type(), params);
    }

    // Int -> native 32-bit argument narrowing; only out-of-range values reach
    // the runtime, which reports the existing numeric error.
    private LlvmRuntimeFunction narrowHelper() {
        String helperName = "__emerald_int64_to_int32";
        ArrayList<LlvmType> params = ArrayList();
        params.add(this.contextValue.int64Type());
        if (this.llvmModule.getFunction(helperName).isNull()) {
            LlvmFunction function = this.createHelper(helperName, this.contextValue.int32Type(), params);
            LlvmBuilder builder = this.contextValue.createBuilder();
            LlvmBasicBlock entry = function.appendBlock("entry");
            LlvmBasicBlock fits = function.appendBlock("fits");
            LlvmBasicBlock failed = function.appendBlock("failed");
            builder.positionAtEnd(entry);
            LlvmValue narrow = builder.truncate(function.parameter(0), this.contextValue.int32Type(), "narrow");
            LlvmValue wide = builder.signExtend(narrow, this.contextValue.int64Type(), "wide");
            builder.conditionalBranch(builder.intEqual(wide, function.parameter(0), "exact"), fits, failed);
            builder.positionAtEnd(fits);
            builder.returnValue(narrow);
            builder.positionAtEnd(failed);
            LlvmRuntimeFunction checked = this.runtimeDeclarationsValue.declare("emerald_int64_to_int32_checked", this.contextValue.int32Type(), params);
            builder.returnValue(this.helperCall(builder, checked, function.parameter(0), "diagnostic"));
            builder.dispose();
        }
        return this.helperFunction(helperName, this.contextValue.int32Type(), params);
    }

    public Void requireMathLibrary() { this.mathLibraryRequiredValue = true; }

    public LlvmValue floatOperation(Int operation, LlvmValue left, LlvmValue right, String name) {
        if (operation == 4) { this.requireMathLibrary(); }
        return LlvmValue(LlvmNative.buildFloatOperation(this.builderValue.handle(), left.handle(), right.handle(), operation, name));
    }

    public LlvmValue asFloat(LlvmValue value, String name) {
        if (value.type().toIr() == "double") { return value; }
        return this.floatOperation(11, value, LlvmValue(this.contextValue.doubleType().handle()), name);
    }

    private LlvmValue adaptRuntimeValue(LlvmValue value, LlvmType expectedType, String name) {
        String actual = value.type().toIr();
        String expected = expectedType.toIr();
        if (actual == "i64" && expected == "i32") {
            LlvmRuntimeFunction cast = this.narrowHelper();
            ArrayList<LlvmValue> castArgs = ArrayList();
            castArgs.add(LlvmValue(value.handle()));
            return this.builderValue.callFunction(cast.type(), cast.function(), castArgs, name + "_narrow");
        }
        if (actual == "i32" && expected == "i64") {
            return this.builderValue.signExtend(value, this.contextValue.int64Type(), name + "_wide");
        }
        return LlvmValue(value.handle());
    }

}
