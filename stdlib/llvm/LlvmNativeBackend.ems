namespace Std::Llvm;

use Std::Collections::ArrayList;
use Std::Collections::IList;
use Std::Native::NativeDirectory;
use Std::Native::NativeFile;
use Std::Native::NativePath;
use Std::Env::Env;

public class LlvmNativeBackend {
    private String moduleName;
    private String outputName;
    private String lastBackendMessage;
    private LlvmContext contextValue;
    private LlvmModule llvmModule;
    private LlvmBuilder builderValue;
    private LlvmRuntime runtimeValue;
    private LlvmRuntimeDeclarations runtimeDeclarationsValue;
    private LlvmNativeLinker linkerValue;
    private LlvmFunction mainFunctionValue;
    private String targetNameValue;
    private String targetTripleValue;
    private String executableExtensionValue;
    private String objectExtensionValue;
    private String emitModeValue;
    private Bool keepTempsValue;
    private String tempBaseValue;
    private String ccValue;
    private String sysrootValue;
    private Bool llvmBridgeValue;
    private Bool mathLibraryRequiredValue;
    private Int listStructHandle;
    private Int stringStructHandle;
    private ArrayList<LlvmValue> staticLiteralItems;
    private Bool staticLiteralsFinalized;

    public LlvmNativeBackend(String name, String output) {
        this.moduleName = name;
        this.outputName = output;
        this.lastBackendMessage = "";
        this.contextValue = Llvm.createContext();
        this.llvmModule = this.contextValue.createModule(name);
        this.builderValue = this.contextValue.createBuilder();
        this.runtimeValue = LlvmRuntime();
        this.runtimeDeclarationsValue = LlvmRuntimeDeclarations(this.contextValue, this.llvmModule);
        this.linkerValue = LlvmNativeLinker();
        this.mainFunctionValue = LlvmFunction(0, 0);
        this.targetNameValue = "native";
        this.targetTripleValue = Llvm.defaultTargetTriple();
        this.executableExtensionValue = Llvm.nativeExecutableExtension();
        this.objectExtensionValue = Llvm.nativeObjectExtension();
        this.emitModeValue = "exe";
        this.keepTempsValue = false;
        this.tempBaseValue = output + ".emerald-build";
        this.ccValue = "";
        this.sysrootValue = "";
        this.llvmBridgeValue = false;
        this.mathLibraryRequiredValue = false;
        this.listStructHandle = 0;
        this.stringStructHandle = 0;
        this.staticLiteralItems = ArrayList();
        this.staticLiteralsFinalized = false;
    }

    public Void configureTarget(String target, String triple, String executableExtension, String objectExtension) {
        this.targetNameValue = target;
        this.targetTripleValue = triple;
        this.executableExtensionValue = executableExtension;
        this.objectExtensionValue = objectExtension;
    }

    public Void configureBuild(String emitMode, Bool keepTemps, String tempBase) {
        this.emitModeValue = emitMode;
        this.keepTempsValue = keepTemps;
        this.tempBaseValue = tempBase;
    }

    public Void configureToolchain(String cc, String sysroot) {
        this.ccValue = cc;
        this.sysrootValue = sysroot;
    }

    public Void configureRuntime(Bool llvmBridge) {
        this.llvmBridgeValue = llvmBridge;
    }

    private Void prepareParentDirectory(String path) {
        String parent = NativePath.parent(path);

        if (parent.isEmpty()) {
            return;
        }

        NativeDirectory.create(parent);
    }

    public Bool initialize() {
        if (!Llvm.initializeTarget(this.targetTripleValue)) {
            this.lastBackendMessage = Llvm.lastError();
            return false;
        }

        this.llvmModule.setTarget(this.targetTripleValue);
        this.applyTargetDataLayout();
        return true;
    }

    // IR is built and optimized against the real target layout (i64 alignment,
    // struct sizes) instead of LLVM's default layout; emission later applies
    // the same layout again for the same triple.
    private Void applyTargetDataLayout() {
        LlvmTarget target = Llvm.lookupTarget(this.targetTripleValue);

        if (target.isNull()) {
            return;
        }

        LlvmTargetMachine machine = target.createMachine(this.targetTripleValue);

        if (machine.isNull()) {
            return;
        }

        machine.applyDataLayout(this.llvmModule);
        machine.dispose();
    }

    // Generated definitions are module-private for executables, so LLVM may
    // inline, specialize and drop them. Object output keeps them external
    // because foreign code may link against the emitted symbols.
    public Int definitionLinkage() {
        if (this.emitModeValue == "obj") {
            return Llvm.externalLinkage();
        }

        return Llvm.internalLinkage();
    }

    public LlvmContext context() {
        return LlvmContext(this.contextValue.handle());
    }

    public LlvmModule llvmModule() {
        return LlvmModule(this.llvmModule.handle(), this.llvmModule.context());
    }

    public LlvmBuilder builder() {
        return LlvmBuilder(this.builderValue.handle());
    }

    public LlvmRuntime runtime() {
        return LlvmRuntime();
    }

    public LlvmRuntimeDeclarations runtimeDeclarations() {
        return LlvmRuntimeDeclarations(this.context(), this.llvmModule());
    }

    public LlvmNativeLinker linker() {
        return LlvmNativeLinker();
    }

    public LlvmFunction mainFunction() {
        return LlvmFunction(this.mainFunctionValue.handle(), this.mainFunctionValue.context());
    }

    public String lastMessage() {
        return this.lastBackendMessage;
    }

    public String objectPath() {
        if (this.emitModeValue == "obj") {
            return this.outputName + this.objectExtensionValue;
        }

        if (this.keepTempsValue) {
            return this.outputName + this.objectExtensionValue;
        }

        return this.tempBaseValue + "/module" + this.objectExtensionValue;
    }

    public String runtimeObjectPath() {
        if (this.keepTempsValue) {
            return this.outputName + "-runtime" + this.objectExtensionValue;
        }

        return this.tempBaseValue + "/runtime" + this.objectExtensionValue;
    }

    public String assemblyPath() {
        return this.outputName + ".s";
    }

    public String executablePath() {
        return this.outputName + this.executableExtensionValue;
    }

    public LlvmFunction beginMain() {
        LlvmType int32 = this.contextValue.int32Type();
        ArrayList<LlvmType> parameters = ArrayList();
        parameters.add(LlvmType(int32.handle()));
        parameters.add(this.contextValue.opaquePointerType());
        LlvmType mainType = this.contextValue.functionTypeWithParams(int32, parameters);
        this.mainFunctionValue = this.llvmModule.addFunction("main", mainType);

        LlvmBasicBlock entry = this.mainFunctionValue.appendBlock("entry");
        this.builderValue.positionAtEnd(entry);

        this.callRuntime(this.runtimeDeclarationsValue.hyperAllocFlowInit(), this.emptyValues(), "");
        LlvmType literalInitType = this.contextValue.functionType(this.contextValue.voidType());
        LlvmFunction literalInit = this.llvmModule.addFunction("__emerald_static_literals_init", literalInitType);
        literalInit.setLinkage(Llvm.internalLinkage());
        this.builderValue.callFunction(literalInitType, literalInit, this.emptyValues(), "");
        ArrayList<LlvmValue> processArguments = ArrayList();
        processArguments.add(this.mainFunctionValue.parameter(0));
        processArguments.add(this.mainFunctionValue.parameter(1));
        this.callRuntime(this.runtimeDeclarationsValue.processSetArgs(), processArguments, "");

        return LlvmFunction(this.mainFunctionValue.handle(), this.mainFunctionValue.context());
    }

    public Void hyperAllocFlowShutdown() {
        this.callRuntime(this.runtimeDeclarationsValue.hyperAllocFlowShutdown(), this.emptyValues(), "");
    }

    public Void returnCode(Int code) {
        this.hyperAllocFlowShutdown();
        this.builderValue.returnValue(this.int32(code));
    }

    public Void returnMainValue(LlvmValue value) {
        this.hyperAllocFlowShutdown();
        this.builderValue.returnValue(this.builderValue.truncate(value, this.contextValue.int32Type(), "main_status"));
    }

    public Void returnMainVoid() {
        this.hyperAllocFlowShutdown();
        this.builderValue.returnVoid();
    }

    public LlvmValue int32(Int value) {
        return Llvm.constInt(this.contextValue.int32Type(), value);
    }

    public LlvmValue int64(Int value) {
        return LlvmValue(LlvmNative.constIntegerText(this.contextValue.int64Type().handle(), value.toString()));
    }

    public LlvmValue boolValue(Bool value) {
        return Llvm.constBool(this.contextValue.boolType(), value);
    }

    public LlvmNativeVariable local(String name, LlvmType type) {
        return LlvmNativeVariable(name, type, this.builderValue.entryAlloca(type, name));
    }

    public LlvmNativeVariable localInt32(String name) {
        return this.local(name, this.contextValue.int32Type());
    }

    public LlvmNativeVariable localInt64(String name) {
        return this.local(name, this.contextValue.int64Type());
    }

    public LlvmValue runtimeString(String value, String name) {
        return this.runtimeStaticString(value, name);
    }

    public LlvmValue runtimeStaticString(String value, String name) {
        return this.staticStringGlobal(value, name);
    }

    private LlvmValue staticStringGlobal(String text, String name) {
        LlvmValue byteValue = LlvmValue(LlvmNative.constString(this.contextValue.handle(), text, true));
        LlvmValue bytes = this.llvmModule.addGlobal(name + "_bytes", byteValue.type());
        bytes.setInitializer(byteValue);
        bytes.setGlobalConstant(true);
        LlvmNative.valueSetLinkage(bytes.handle(), Llvm.privateLinkage());
        ArrayList<LlvmValue> fields = ArrayList();
        fields.add(this.int64(text.length()));
        fields.add(LlvmValue(bytes.handle()));
        LlvmValue constant = LlvmValue(LlvmNative.constStruct(this.contextValue.handle(), fields, false));
        LlvmValue object = this.llvmModule.addGlobal(name, constant.type());
        object.setInitializer(constant);
        object.setGlobalConstant(true);
        LlvmNative.valueSetLinkage(object.handle(), Llvm.privateLinkage());
        this.staticLiteralItems.add(LlvmValue(object.handle()));
        return LlvmValue(object.handle());
    }

    private Void finalizeStaticLiterals() {
        if (this.staticLiteralsFinalized) { return; }
        this.staticLiteralsFinalized = true;
        LlvmFunction function = this.llvmModule.getFunction("__emerald_static_literals_init");
        if (function.isNull()) { return; }
        LlvmBuilder builder = this.contextValue.createBuilder();
        builder.positionAtEnd(function.appendBlock("entry"));
        if (this.staticLiteralItems.size() > 0) {
            LlvmValue values = LlvmValue(LlvmNative.constArray(this.contextValue.opaquePointerType().handle(), this.staticLiteralItems));
            LlvmValue table = this.llvmModule.addGlobal("__emerald_static_literals", values.type());
            table.setInitializer(values);
            table.setGlobalConstant(true);
            LlvmNative.valueSetLinkage(table.handle(), Llvm.privateLinkage());
            ArrayList<LlvmType> params = ArrayList();
            params.add(this.contextValue.opaquePointerType());
            params.add(this.contextValue.int64Type());
            LlvmRuntimeFunction registration = this.runtimeDeclarationsValue.declare("hyperalloc_flow_register_static_strings", this.contextValue.voidType(), params);
            ArrayList<LlvmValue> args = ArrayList();
            args.add(LlvmValue(table.handle()));
            args.add(this.int64(this.staticLiteralItems.size()));
            builder.callFunction(registration.type(), registration.function(), args, "");
        }
        builder.returnVoid();
        builder.dispose();
    }

    public LlvmValue listNew(String name) {
        return this.callRuntime(this.runtimeDeclarationsValue.listNew(), this.emptyValues(), name);
    }

