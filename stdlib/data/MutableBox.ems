namespace Std::Data;

use Std::Data::IMutableBox;

public class MutableBox<T> implements IMutableBox<T> {
    private T stored;

    public MutableBox(T value) {
        this.stored = value;
    }

    public T value() {
        return this.stored;
    }

    public Void set(T value) {
        this.stored = value;
    }
}
