namespace Std::Ui;

use Std::Native::NativeFile;

public class EmHtmlRuntime {
    public EmHtmlRuntime() {
    }

    public static String load(String path) {
        return NativeFile.readText(path);
    }

    public static Bool exists(String path) {
        return NativeFile.exists(path);
    }

    public static String eventAttribute(String action) {
        return "data-em-action=\"" + action + "\"";
    }

    public static String text(String value) {
        return value;
    }
}
