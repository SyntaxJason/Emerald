namespace Std::Compare;

use Std::Compare::IComparator;

public class NaturalIntComparator implements IComparator<Int> {
    public NaturalIntComparator() {
    }

    public Int compare(Int left, Int right) {
        if (left < right) { return -1; }
        if (left > right) { return 1; }
        return 0;
    }
}
