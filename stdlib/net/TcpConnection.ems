namespace Std::Net;

use Std::Native::NativeTcp;
use Std::Net::Endpoint;
use Std::Net::IEndpoint;
use Std::Net::ITcpConnection;
use Std::Result::Failure;
use Std::Result::BoolSuccess;
use Std::Result::IResult;
use Std::Result::Success;

public class TcpConnection implements ITcpConnection {
    private Int socketHandle;
    private Endpoint remoteEndpoint;

    public TcpConnection(Int handle, IEndpoint endpoint) {
        this.socketHandle = handle;
        this.remoteEndpoint = Endpoint(endpoint.host(), endpoint.port());
    }

    public IEndpoint endpoint() {
        return this.remoteEndpoint;
    }

    public Int handle() {
        return this.socketHandle;
    }

    public Bool isOpen() {
        return NativeTcp.isOpen(this.socketHandle);
    }

    public String readText() {
        return NativeTcp.readText(this.socketHandle);
    }

    public String readLine() {
        return NativeTcp.readLine(this.socketHandle);
    }

    public String readOr(String fallback) {
        if (!this.isOpen()) {
            return fallback;
        }

        return this.readText();
    }

    public String readLineOr(String fallback) {
        if (!this.isOpen()) {
            return fallback;
        }

        return this.readLine();
    }

    public IResult<String, String> tryReadText() {
        if (!this.isOpen()) {
            return Failure("TCP connection is closed");
        }

        return Success(this.readText());
    }

    public IResult<String, String> tryReadLine() {
        if (!this.isOpen()) {
            return Failure("TCP connection is closed");
        }

        return Success(this.readLine());
    }

    public Bool writeText(String text) {
        return NativeTcp.writeText(this.socketHandle, text);
    }

    public Bool writeLine(String text) {
        return this.writeText(text + "\n");
    }

    public IResult<Bool, String> tryWriteText(String text) {
        if (!this.isOpen()) {
            return Failure("TCP connection is closed");
        }

        if (!this.writeText(text)) {
            return Failure("Could not write to TCP connection");
        }

        return BoolSuccess(true);
    }

    public IResult<Bool, String> tryWriteLine(String text) {
        return this.tryWriteText(text + "\n");
    }

    public Bool close() {
        return NativeTcp.close(this.socketHandle);
    }

    public Bool closeIfOpen() {
        if (!this.isOpen()) {
            return true;
        }

        return this.close();
    }

    public IResult<Bool, String> tryClose() {
        if (!this.isOpen()) {
            return BoolSuccess(true);
        }

        if (!this.close()) {
            return Failure("Could not close TCP connection");
        }

        return BoolSuccess(true);
    }
}
