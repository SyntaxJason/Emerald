namespace Std::Net;

use Std::Native::NativeTcp;
use Std::Net::Endpoint;
use Std::Net::IEndpoint;
use Std::Net::ITcpConnection;
use Std::Net::ITcpListener;
use Std::Net::TcpConnection;
use Std::Result::Failure;
use Std::Result::BoolSuccess;
use Std::Result::IResult;
use Std::Result::Success;

public class TcpListener implements ITcpListener {
    private Int listenerHandle;
    private Endpoint localEndpoint;

    public TcpListener(Int handle, IEndpoint endpoint) {
        this.listenerHandle = handle;
        this.localEndpoint = Endpoint(endpoint.host(), endpoint.port());
    }

    public IEndpoint endpoint() {
        return this.localEndpoint;
    }

    public Int handle() {
        return this.listenerHandle;
    }

    public Bool isOpen() {
        return NativeTcp.listenerIsOpen(this.listenerHandle);
    }

    public IResult<ITcpConnection, String> accept() {
        Int socket = NativeTcp.accept(this.listenerHandle);

        if (socket < 0) {
            return Failure("Could not accept TCP connection");
        }

        return Success(TcpConnection(socket, Endpoint("accepted", 0)));
    }

    public Bool close() {
        return NativeTcp.closeListener(this.listenerHandle);
    }

    public Bool closeIfOpen() {
        if (!this.isOpen()) {
            return true;
        }

        return this.close();
    }

    public IResult<Bool, String> tryClose() {
        if (!this.isOpen()) {
            return BoolSuccess(true);
        }

        if (!this.close()) {
            return Failure("Could not close TCP listener");
        }

        return BoolSuccess(true);
    }
}
