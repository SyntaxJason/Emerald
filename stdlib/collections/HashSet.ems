namespace Std::Collections;

use Std::Collections::ISet;
use Std::Collections::HashMap;
use Std::Collections::IIterator;
use Std::Collections::IList;
use Std::Collections::ArrayList;
use Std::Functional::IConsumer;
use Std::Functional::IPredicate;

public class HashSet<T> implements ISet<T> {
    private HashMap<T, Bool> storage;

    public HashSet() {
        this.storage = HashMap();
    }

    public IIterator<T> iterator() {
        return this.storage.keys().iterator();
    }

    public Int size() {
        return this.storage.size();
    }

    public Bool isEmpty() {
        return this.storage.isEmpty();
    }

    public Bool contains(T value) {
        return this.storage.containsKey(value);
    }

    public Bool add(T value) {
        return this.storage.putIfAbsent(value, true);
    }

    public Bool remove(T value) {
        return this.storage.removeIfPresent(value);
    }

    public Void clear() {
        this.storage.clear();
    }

    public IList<T> toList() {
        return this.storage.keys();
    }

    public Void forEach(Std::Functional::IConsumer<T> consumer) {
        Int slot = 0;

        while (slot < this.storage.slotCount()) {
            if (this.storage.slotIsLive(slot)) {
                consumer.accept(this.storage.slotKey(slot));
            }

            slot = slot + 1;
        }
    }

    public Bool any(Std::Functional::IPredicate<T> predicate) {
        Int slot = 0;

        while (slot < this.storage.slotCount()) {
            if (this.storage.slotIsLive(slot) && predicate.test(this.storage.slotKey(slot))) {
                return true;
            }

            slot = slot + 1;
        }

        return false;
    }

    public Bool all(Std::Functional::IPredicate<T> predicate) {
        Int slot = 0;

        while (slot < this.storage.slotCount()) {
            if (this.storage.slotIsLive(slot) && !predicate.test(this.storage.slotKey(slot))) {
                return false;
            }

            slot = slot + 1;
        }

        return true;
    }
}
