namespace Std::Collections;

// Last-in first-out stack.
public class Stack<T> {
    private List<T> items;

    public Stack() {
        this.items = List();
    }

    public Int size() { return this.items.length(); }
    public Bool isEmpty() { return this.items.isEmpty(); }
    public Void clear() { this.items.clear(); }
    public Void push(T value) { this.items.add(value); }

    public T pop() {
        if (this.items.isEmpty()) { panic("Stack is empty"); }
        return this.items.removeAt(this.items.length() - 1);
    }

    public T peek() {
        if (this.items.isEmpty()) { panic("Stack is empty"); }
        return this.items.get(this.items.length() - 1);
    }

    public T peekOr(T fallback) {
        if (this.items.isEmpty()) { return fallback; }
        return this.items.get(this.items.length() - 1);
    }
}
