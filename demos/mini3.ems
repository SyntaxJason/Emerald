class Node {
    private Int count;

    public Node() {
        this.count = 0;
    }

    public Int sum() {
        Int total = 0;

        if (this.count > 0) {
            total = total + 1;
        }

        return total;
    }
}

main() {
    Node n = Node();
    println(n.sum().toString());
    return 0;
}
