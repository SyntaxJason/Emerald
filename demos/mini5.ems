class Widget {
    private Int count;

    public Widget() {
        this.count = 0;
    }

    public Int sum() {
        Int total = 0;

        if (this.count > 0) {
            total = total + 1;
        }

        return total;
    }
}

main() {
    Widget w = Widget();
    println(w.sum().toString());
    return 0;
}
