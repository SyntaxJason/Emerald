use Std::Native::NativeTime;

main() {
    Int t0 = NativeTime.monotonicMillis();
    Int sum = 0;
    Int i = 0;

    while (i < 50000000) {
        sum = sum + i;
        i = i + 1;
    }

    Int t1 = NativeTime.monotonicMillis();
    println("t0=" + t0.toString() + " t1=" + t1.toString() + " delta=" + (t1 - t0).toString() + " sum=" + sum.toString());
    return 0;
}
