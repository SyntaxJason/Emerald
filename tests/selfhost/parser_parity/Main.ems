use Std::Collections::ArrayList;

main() {
    Int result = 0;

    if (false) {
        result = 1;
    } else if (true) {
        result = 42;
    } else {
        result = 2;
    }

    String normalized = "4-2";
    normalized = normalized.replace("-", "");
    String segment = "x42y".substring(1, 3);
    Int hyphenIndex = "x-42".indexOf("-");
    String bang = "!";
    String closing = ")";
    ArrayList<String> symbols = ArrayList();
    symbols.add("]");
    symbols.add(",");

    if (normalized != "42" || segment != "42" || hyphenIndex != 1 || result != 42 || bang != "!" || closing != ")" || symbols.size() != 2) {
        println(0);
    } else {
        println(result);
    }
}
