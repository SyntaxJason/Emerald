public class HyperAllocFlowV1ShardBreakLeft {
    public Int value;

    public HyperAllocFlowV1ShardBreakLeft(Int value) {
        this.value = value;
    }
}

public class HyperAllocFlowV1ShardBreakRight {
    public Int value;

    public HyperAllocFlowV1ShardBreakRight(Int value) {
        this.value = value;
    }
}

main() {
    while (true) {
        HyperAllocFlowV1ShardBreakLeft left = HyperAllocFlowV1ShardBreakLeft(20);
        HyperAllocFlowV1ShardBreakRight right = HyperAllocFlowV1ShardBreakRight(22);
        println((left.value + right.value).toString());
        break;
    }
}
