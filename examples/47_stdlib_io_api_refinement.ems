use Std::Io::FileSystem;
use Std::Io::IFileSystem;
use Std::Io::IPath;
use Std::Io::IDirectory;
use Std::Io::IFile;
use Std::Io::IFileInfo;
use Std::Io::ITextReader;
use Std::Io::ITextWriter;
use Std::Result::IResult;

main() {
    IFileSystem fs = FileSystem();
    IPath workingPath = fs.workingDirectory();
    IDirectory working = fs.directoryAt(workingPath);
    IFile file = fs.fileInWorkingDirectory("emerald_io_api_refined.txt");

    file.ensureParentDirectory();

    ITextWriter writer = file.writer();
    IResult<Bool, String> writeResult = writer.tryWriteLine("alpha");
    writer.appendLine("beta");

    ITextReader reader = file.reader();
    String text = reader.readOr("missing");
    IFileInfo info = file.info();

    println(writeResult.isSuccess().toString());
    println(text.contains("alpha").toString());
    println(info.isMissing().toString());
    println(working.contains("emerald_io_api_refined.txt").toString());
    println(file.path().sibling("emerald_io_api_refined_sibling.txt").fileName());
    file.clear();
    println(file.deleteIfExists().toString());
}
