macro AutoToString on Class {
    StatementAST returnStmt = Stmt::return(
        Expr::str("instance of " + class.name)
    );
    BlockAST body = Block::of([returnStmt]);
    MethodAST toStr = MethodAST::create("toString", "String", [], body);
    class.addMethod(toStr);
}

@AutoToString
public class User {
    public String name;

    public User(String name) {
        this.name = name;
    }
}

main() {
    User u = User("Alice");
    println(u.toString());
}
