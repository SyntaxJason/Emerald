use Std::Time::OffsetDateTime;

main() {
    OffsetDateTime first = OffsetDateTime.of(2026, 5, 14, 2, 20, 0, 120);
    OffsetDateTime second = OffsetDateTime.of(2026, 5, 14, 3, 20, 0, 120);
    OffsetDateTime same = OffsetDateTime.of(2026, 5, 14, 2, 20, 0, 120);

    println(first.isBefore(second).toString());
    println(second.isAfter(first).toString());
    println(first.isEqual(same).toString());
    println(first.compareTo(second).toString());
}
