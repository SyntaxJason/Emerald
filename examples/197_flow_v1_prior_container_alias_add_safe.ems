        this.value = value;
    }
}

main() {
    List<HyperAllocFlowV1PriorAliasViewBox> values = List();
    List<HyperAllocFlowV1PriorAliasViewBox> mirror = values;
    HyperAllocFlowV1PriorAliasViewBox first = HyperAllocFlowV1PriorAliasViewBox(42);
