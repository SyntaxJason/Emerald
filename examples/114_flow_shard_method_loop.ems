public class HyperAllocFlowShardPacket {
    private Int value;

    public HyperAllocFlowShardPacket(Int value) {
        this.value = value;
    }

    public Int read() {
        return this.value;
    }
}

public class HyperAllocFlowShardRunner {
    public Int run() {
        Int index = 0;
        Int total = 0;

        while (index < 3) {
            HyperAllocFlowShardPacket packet = HyperAllocFlowShardPacket(index);
            total = total + packet.read();
            index = index + 1;
        }

        return total;
    }
}

main() {
    HyperAllocFlowShardRunner runner = HyperAllocFlowShardRunner();
    println(runner.run().toString());
}
