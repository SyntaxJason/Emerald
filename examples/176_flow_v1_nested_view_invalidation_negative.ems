public class HyperAllocFlowV1NestedInvalidViewBox {
    public Int value;

    public HyperAllocFlowV1NestedInvalidViewBox(Int value) {
        this.value = value;
    }
}

main() {
    List<HyperAllocFlowV1NestedInvalidViewBox> values = List();
    HyperAllocFlowV1NestedInvalidViewBox owned = HyperAllocFlowV1NestedInvalidViewBox(42);
    values.add(owned);
    HyperAllocFlowV1NestedInvalidViewBox view = values.get(0);

    if (true) {
        values.removeAt(0);
    }

    println(view.value.toString());
}
